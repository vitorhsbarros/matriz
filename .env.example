# Copy this file to .env and replace every value. .env is ignored by Git: never commit it.
# All values below are fictitious examples.

# Database (used by the application and by compose.yaml)
MATRIZ_DB_NAME=matriz
MATRIZ_DB_USER=matriz
MATRIZ_DB_PASSWORD=change-me-db-password
MATRIZ_DB_URL=jdbc:postgresql://localhost:5432/matriz

# Demo data (FR21, US19): set to true to create the demo accounts and projects at start-up.
# Existing data is never changed or deleted. Passwords: 8 to 128 characters.
MATRIZ_DEMO_SEED=true
MATRIZ_DEMO_PASSWORD_ANA=change-me-ana
MATRIZ_DEMO_PASSWORD_RUI=change-me-rui
MATRIZ_DEMO_PASSWORD_SARA=change-me-sara

# Session cookie (SEC06, SEC08). Keep true on any server, which must use HTTPS. Set to false only for
# http://localhost, because Safari doesn't keep a Secure cookie there and log-in wouldn't stick.
MATRIZ_COOKIE_SECURE=false
